enum DocketNumberType {
  auto
  manual
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model XeroAuth {
  id        Int      @id @default(autoincrement())
  tokenSet  Json     @default("{}")
  tenantId  String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  email     String
}

model Product {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  basePrice Float
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt
  dockets   Docket[]
  prices    ProductPrice[]
}

model ProductPrice {
  id         Int      @id @default(autoincrement())
  productId  Int
  customerId String
  price      Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, customerId])
}

model Docket {
  id                 Int       @id @default(autoincrement())
  date               DateTime
  driverRegNumber    String?
  customerId         String
  productId          Int
  orderNumber        String
  deliveryAddress    String?
  inspectedBy        String?
  deliveredBy        String?
  receivedBy         String?
  createdAt          DateTime  @default(now())
  price              Float
  status             Int       @default(1)
  updatedAt          DateTime  @updatedAt

    // --- CHANGES START HERE ---
  // docketNumber       Int       @default(autoincrement())
  docketNumber       String    @unique // Changed from Int @default(autoincrement())
  docketNumberType   DocketNumberType @default(manual) // New field
  
  // --- CHANGES END HERE ---
  invoiceGeneratedBy String?
  invoiceGeneratedOn DateTime?
  weight             Float?
  product            Product   @relation(fields: [productId], references: [id])
}
