// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model XeroAuth {
  id        Int      @id @default(autoincrement())
  tokenSet  Json     @default("{}")
  tenantId  String?
  updatedAt DateTime @updatedAt
}

model Product {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  basePrice Float? // Optional default price
  prices    ProductPrice[] // Customer-specific prices
  dockets   Docket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ProductPrice {
  id         Int     @id @default(autoincrement())
  productId  Int
  customerId String // ID from Xero API
  price      Float
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([productId, customerId]) // One price per product-customer pair
}

model Docket {
  id              Int      @id @default(autoincrement())
  date            DateTime // Date field
  driverRegNumber String?
  customerId      String
  productId       Int
  orderNumber     String
  docketNumber    Int      @default(autoincrement())
  deliveryAddress String?
  inspectedBy     String?
  deliveredBy     String?
  firstWeight     Float?
  secondWeight    Float?
  thirdWeight     Float?
  receivedBy      String?
  price           Float
  status          Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}
